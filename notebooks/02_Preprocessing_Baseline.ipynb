import pandas as pd, numpy as np
from sklearn.pipeline import Pipeline
from sklearn.compose import ColumnTransformer
from sklearn.preprocessing import StandardScaler
from sklearn.linear_model import LogisticRegression

DATA_PATH = '/content/drive/MyDrive/Fraud-ATO-Detection/data/creditcard.csv'
df = pd.read_csv(DATA_PATH).drop_duplicates().reset_index(drop=True)

# Time bas lel sorting wel split, mesh feature
df = df.sort_values('Time').reset_index(drop=True)
df['Hour'] = (df['Time'] % 86400) // 3600   # sa3a men bedayet el yom (relative)

split = int(len(df) * 0.80)
train, test = df.iloc[:split], df.iloc[split:]

features = [c for c in df.columns if c not in ('Class', 'Time')]
X_train, y_train = train[features], train['Class']
X_test,  y_test  = test[features],  test['Class']

pre = ColumnTransformer([('scale', StandardScaler(), ['Amount', 'Hour'])],
                        remainder='passthrough')
model = Pipeline([('pre', pre),
                  ('clf', LogisticRegression(class_weight='balanced',
                                             max_iter=1000, random_state=42))])
model.fit(X_train, y_train)
